{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "migration:create": "bun ./node_modules/@mikro-orm/cli/cli migration:create --config ./src/config/mikro-orm.config.ts",
    "migration:create:initial": "bun ./node_modules/@mikro-orm/cli/cli migration:create --initial --config ./src/config/mikro-orm.config.ts",
    "migration:up": "bun ./node_modules/@mikro-orm/cli/cli migration:up --config ./src/config/mikro-orm.config.ts",
    "migration:down": "bun ./node_modules/@mikro-orm/cli/cli migration:down --config ./src/config/mikro-orm.config.ts",
    "migration:list": "bun ./node_modules/@mikro-orm/cli/cli migration:list --config ./src/config/mikro-orm.config.ts",
    "migration:pending": "bun ./node_modules/@mikro-orm/cli/cli migration:pending --config ./src/config/mikro-orm.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "npm run build && vitest run --config ./vitest.config.integration.ts",
    "test:integration:db:up": "docker compose -p wagering-bet-repositories-test --profile test -f docker-compose.test.yml up -d --wait postgres",
    "test:integration:db:down": "docker compose -p wagering-bet-repositories-test --profile test -f docker-compose.test.yml down"
  },
  "dependencies": {
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/nestjs": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.17",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
